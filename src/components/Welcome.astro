---
import background from "../assets/background.webp";
---

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <main>
    <nav id="navbar">
      <a id="logo">Altitude</a>
      <a href="mailto:rnoyer.dev@gmail.com" class="link">Contact</a>
    </nav>
    <section id="hero">
      <h1>Get your App.</h1>
    </section>
  </main>
</div>

<style>
  a {
    all: unset;
    cursor: pointer;
    height: auto;
  }

  #container {
    display: flex;
    flex-direction: column;
    color: #fff;
    font-family: var(--font-poppins);
    height: 100%;
  }
  #navbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  #navbar > a {
    padding: 1rem 2rem;
  }

  #logo {
    font-size: 3rem;
    font-weight: 500;
  }

  .link {
    font-size: 1.5rem;
    text-align: center;
    border-radius: 0.5rem;
  }

  .link:hover {
    color: black;
    transition: all 0.3s ease;
  }

  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-fit: cover;
  }

  main {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #hero {
    flex: 1;
    display: flex;
    align-items: start;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1rem;
    font-size: 3rem;
    font-weight: 900;
  }

  h1 {
    /* all: unset; */
    margin: 3rem 3rem;
    margin-left: 3rem;
  }

  @media screen and (max-height: 368px) {
  }

  @media screen and (max-width: 768px) {
    #logo {
      all: unset;
      font-size: 2rem;
      font-weight: 500;
    }

    h1 {
      margin: 1rem 3rem;
      text-align: center;
    }
  }
</style>
