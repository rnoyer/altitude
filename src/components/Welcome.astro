---
import background from "../assets/background.webp";
---

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <main>
    <nav id="navbar">
      <p id="logo">Altitude</p>
      <a class="link">Contact</a>
    </nav>
    <section id="hero">
      <h1>Get your App.</h1>
    </section>
  </main>
</div>

<style>
  #container {
    color: #fff;
  }

  #navbar {
    /* filter: blur(10); */
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 2rem;
  }

  #logo {
    all: unset;
    font-size: 3rem;
    font-weight: 500;
  }

  .link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-size: 1.5rem;
    text-align: center;
    cursor: pointer;
  }

  a:hover {
    color: black;
  }

  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-fit: cover;
  }

  #container {
    font-family: var(--font-poppins);
    height: 100%;
  }

  main {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #hero {
    flex: 1;
    display: flex;
    align-items: start;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1rem;
    font-size: 3rem;
    font-weight: 900;
  }

  hero,
  h1 {
    margin-left: 3rem;
  }

  @media screen and (max-height: 368px) {
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    #hero {
      display: block;
      padding-top: 10%;
    }
  }
</style>
